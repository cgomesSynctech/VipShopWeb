@page "/funcionarios"
@using Microsoft.EntityFrameworkCore
@using VipshopWeb.Core.Entities
@inject IDbContextFactory<VipshopDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ITenantProvider TenantProvider
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold mb-4">Cadastro de Funcionários</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6">Gerenciamento de colaboradores do time interno</MudText>

    <!-- TABELA DE LISTAGEM -->
    <MudTable Items="@listaFuncionarios" Dense="true" Hover="true" Bordered="true" Striped="true" Class="mb-8" Elevation="2">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Funcionários Ativos</MudText>
            <MudSpacer />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome Completo</MudTh>
            <MudTh>CPF</MudTh>
            <MudTh>Cargo</MudTh>
            <MudTh>Salário</MudTh>
            <MudTh>Data Admissão</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome Completo">@context.Favorecido.NomeRazaoSocial</MudTd>
            <MudTd DataLabel="CPF">@context.Favorecido.Documento</MudTd>
            <MudTd DataLabel="Cargo">@context.Cargo</MudTd>
            <MudTd DataLabel="Salário">@context.Salario.ToString("C2", _culture)</MudTd>
            <MudTd DataLabel="Data Admissão">@context.DataAdmissao.ToString("dd/MM/yyyy")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-4">Nenhum funcionário cadastrado até o momento.</MudText>
        </NoRecordsContent>
    </MudTable>

    <!-- FORMULÁRIO DE CADASTRO -->
    <MudPaper Elevation="4" Class="pa-8" Style="border-radius: 12px;">
        <MudText Typo="Typo.h5" Class="mb-6 font-weight-bold">Novo Funcionário</MudText>

        <MudForm @ref="form" @bind-IsValid="@formValido">
            <MudGrid>
                <!-- Campos em Comum (Favorecido - Funcionário é sempre PF) -->
                <MudTextField @bind-Value="favorecidoModel.Documento"
                              Label="CPF do Funcionário"
                              Variant="Variant.Outlined"
                              Required="true"
                              Clearable="true"
                              Mask="@func_cpfMask" />


                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="favorecidoModel.NomeRazaoSocial" Label="Nome Completo"
                                  Variant="Variant.Outlined" Required="true" MaxLength="150" />
                </MudItem>

                <!-- Campos Específicos de Funcionário -->
                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.button" Color="Color.Primary" Class="font-weight-bold">Dados do Contrato de Trabalho (CLT/Internal)</MudText>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="funcionarioModel.Cargo" Label="Cargo Executado"
                                  Variant="Variant.Outlined" Required="true" MaxLength="100" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudNumericField @bind-Value="funcionarioModel.Salario" Label="Salário Base"
                                     Variant="Variant.Outlined" Format="N2" Culture="@_culture" HideSpinButtons="true" Required="true" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudDatePicker @bind-Date="dataAdmissaoNulavel" Label="Data de Admissão"
                                   Editable="true" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Required="true" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="funcionarioModel.Ctps" Label="Nº da CTPS (Carteira de Trabalho)"
                                  Variant="Variant.Outlined" MaxLength="20" />
                </MudItem>

                <!-- Botão de Gravação -->
                <MudItem xs="12" Class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="SalvarFuncionario" Class="px-8">
                        Gravar Funcionário
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private IMask func_cpfMask = new PatternMask("000.000.000-00");
    private MudForm form = null!;
    private bool formValido;
    private System.Globalization.CultureInfo _culture = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    private List<Funcionario> listaFuncionarios = new();
    private Favorecido favorecidoModel = new() { TipoFavorecidoId = 3, TipoPessoa = "PF" }; // 3 fixo = Funcionário / Sempre PF
    private Funcionario funcionarioModel = new();
    private DateTime? dataAdmissaoNulavel = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var tenantClaim = authState.User.FindFirst("Tenant")?.Value;

        if (!string.IsNullOrEmpty(tenantClaim))
        {
            TenantProvider.SetTenant(tenantClaim);
            await CarregarGrid();
        }
    }

    private async Task CarregarGrid()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            listaFuncionarios = await context.Funcionarios
                .Include(f => f.Favorecido)
                .OrderByDescending(f => f.Favorecido.DataCadastro)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar funcionários: {ex.Message}", Severity.Error);
        }
    }

    private async Task SalvarFuncionario()
    {
        await form.Validate();
        if (!formValido)
        {
            Snackbar.Add("Por favor, preencha os campos obrigatórios.", Severity.Warning);
            return;
        }

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            favorecidoModel.Documento = new string(favorecidoModel.Documento.Where(char.IsDigit).ToArray());
            favorecidoModel.DataCadastro = DateTime.UtcNow;

            funcionarioModel.DataAdmissao = dataAdmissaoNulavel ?? DateTime.UtcNow;
            funcionarioModel.Favorecido = favorecidoModel;

            context.Funcionarios.Add(funcionarioModel);
            await context.SaveChangesAsync();

            Snackbar.Add($"Funcionário {favorecidoModel.NomeRazaoSocial} registrado com sucesso!", Severity.Success);

            ResetarFormulario();
            await CarregarGrid();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Falha ao salvar funcionário: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private void ResetarFormulario()
    {
        favorecidoModel = new() { TipoFavorecidoId = 3, TipoPessoa = "PF" };
        funcionarioModel = new();
        dataAdmissaoNulavel = DateTime.Today;
    }
}
